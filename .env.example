# Generate a value with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret

# Optional. Required only for nearby hospital suggestions.
# Restrict this key to the required Google Geocoding and Places APIs.
GOOGLE_MAPS_API_KEY=
FACILITY_API_TIMEOUT=5

# Set to 1 only when HTTPS is enforced by the deployment platform.
SESSION_COOKIE_SECURE=0

# Maximum request body size in bytes.
MAX_CONTENT_LENGTH=16384
